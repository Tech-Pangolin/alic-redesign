# Google Sheets (server / Vercel only — never put these in the Hostinger static build)
GOOGLE_SHEET_ID=
GOOGLE_SECONDARY_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Comma-separated origins allowed to call /api/contact (set on Vercel)
# Example: https://dev.atllifeinsurance.com,https://www.dev.atllifeinsurance.com
CONTACT_ALLOWED_ORIGINS=

# Absolute contact API URL for the Hostinger static site build (`npm run build:static`).
# Example: https://your-app.vercel.app/api/contact
# Leave unset for same-origin (local / Vercel full-site deploy via `npm run build`).
NEXT_PUBLIC_CONTACT_API_URL=https://alic-redesign.vercel.app/api/contact

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-0TNVPCP4PN
